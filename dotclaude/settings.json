{
  "permissions": {
    "allow": [
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(make audit)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(make test-*)",
      "Bash(make verify)",
      "Bash(swift test *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" reply-require-japanese pre"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" pr-gate"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" rules-detect-bash-edits pre"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" rules-detect-bash-edits edit"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" rules-require-read"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" ctx-limit-read"
          },
          {
            "type": "command",
            "if": "Read(//**/rules/*.md)",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" rules-require-read"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" rules-detect-bash-edits post"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(//**/*.md)",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" docs-check"
          },
          {
            "type": "command",
            "if": "Write(//**/*.md)",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" docs-check"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" rules-detect-bash-edits edit"
          },
          {
            "type": "command",
            "if": "Edit(//**/*.sh)",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" shell-check"
          },
          {
            "type": "command",
            "if": "Write(//**/*.sh)",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" shell-check"
          },
          {
            "type": "command",
            "if": "Edit(//**/*.swift)",
            "command": "input=$(cat); printf '%s' \"$input\" | bash \"$HOME/.claude/hooks/run.sh\" swift-format; printf '%s' \"$input\" | bash \"$HOME/.claude/hooks/run.sh\" swift-style-check"
          },
          {
            "type": "command",
            "if": "Write(//**/*.swift)",
            "command": "input=$(cat); printf '%s' \"$input\" | bash \"$HOME/.claude/hooks/run.sh\" swift-format; printf '%s' \"$input\" | bash \"$HOME/.claude/hooks/run.sh\" swift-style-check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run.sh\" reply-require-japanese stop"
          }
        ]
      }
    ]
  },
  "outputStyle": "report"
}
