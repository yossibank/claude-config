{
  "permissions": {
    "allow": [
      "Bash(make verify)",
      "Bash(make audit)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(make test-*)",
      "Bash(swift test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" ctx-limit-read"
          },
          {
            "type": "command",
            "if": "Read(//**/rules/*.md)",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" rules-require-read"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" rules-require-read"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" rules-detect-bash-edits edit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" rules-detect-bash-edits pre"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" pr-gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(//**/*.md)",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" docs-check"
          },
          {
            "type": "command",
            "if": "Write(//**/*.md)",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" docs-check"
          },
          {
            "type": "command",
            "if": "Edit(//**/*.swift)",
            "command": "input=$(cat); printf '%s' \"$input\" | bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" swift-format; printf '%s' \"$input\" | bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" swift-style-check"
          },
          {
            "type": "command",
            "if": "Write(//**/*.swift)",
            "command": "input=$(cat); printf '%s' \"$input\" | bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" swift-format; printf '%s' \"$input\" | bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" swift-style-check"
          },
          {
            "type": "command",
            "if": "Edit(//**/*.sh)",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" shell-check"
          },
          {
            "type": "command",
            "if": "Write(//**/*.sh)",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" shell-check"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" rules-detect-bash-edits edit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" rules-detect-bash-edits post"
          }
        ]
      }
    ]
  },
  "outputStyle": "report"
}
