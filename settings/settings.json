{
  "permissions": {
    "allow": [
      "Bash(make verify)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(swift test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" ctx-limit-read"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" rules-require-read"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" rules-detect-bash-edits pre"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" pr-gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" docs-check"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" swift-format"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" shell-check"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" ctx-suggest-clear pr"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" rules-detect-bash-edits post"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" ctx-suggest-clear"
          }
        ]
      }
    ]
  }
}
