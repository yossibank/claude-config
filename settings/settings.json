{
  "permissions": {
    "allow": [
      "Bash(make verify)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(swift test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" pre-read-guard"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" pre-edit-load-rules"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" bash-check-edits pre"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" pre-bash-check-pr"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" post-edit-check-docs"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" post-edit-format-swift"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" post-edit-check-shell"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" ctx-suggest-clear pr"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" bash-check-edits post"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Applications/AI/claude-config/hooks/run.sh\" ctx-suggest-clear 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
